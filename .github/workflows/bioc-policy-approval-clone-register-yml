name: Bioconductor Policy Acceptance Clone and Register

on:
  issue_comment:
    types: [created]

permissions:
  issues: write
  contents: write

jobs:
  approve_and_clone:
    runs-on: ubuntu-latest
    if: github.event.comment.body == 'accept-policies' || github.event.comment.body == '/accept-policies'

    steps:
      - name: Checkout workflow repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install requests pyyaml

      - name: Handle policy acceptance
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITHUB_EVENT_PATH: ${{ github.event_path }}
          GITHUB_REPOSITORY: ${{ github.repository }}
        run: python scripts/accept_policies.py

      - name: Clone Default Branch & Register
        env:
          TARGET_GITHUB_TOKEN: ${{ secrets.TARGET_GITHUB_TOKEN }}
          GIT_TARGET_ORG: "tempbioc"
          GITHUB_EVENT_PATH: ${{ github.event_path }}
          GITHUB_REPOSITORY: ${{ github.repository }}
        run: python scripts/clone_and_register.py